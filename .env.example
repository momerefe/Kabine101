# Copy to .env. Never commit real connection strings.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://kocbenefits_local:CHANGE_ME@127.0.0.1:5432/kocbenefits_dev?sslmode=disable
# Dedicated disposable test database. Never use production here.
TEST_DATABASE_URL=postgres://kocbenefits_local:CHANGE_ME@127.0.0.1:5432/kocbenefits_test?sslmode=disable
SCHOOL_EMAIL_DOMAIN=stu.koc.k12.tr
# Registration always requires a separate manual administrator decision.
ELIGIBILITY_POLICY=manual
REGISTRATION_OPEN=true
APP_ORIGIN=http://127.0.0.1:5173
# Local Mailpit (tools/dev.ps1 mail). Production requires false and TLS SMTP.
LOCAL_EMAIL=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@kocbenefits.example
SMTP_USERNAME=
SMTP_PASSWORD=
